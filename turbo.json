{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"],
      "env": ["PR_NUMBER"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test-ci": {
      "dependsOn": ["^test-ci"]
    },
    "@kavita-likes-fajitas/ui-library#typecheck": {
      "dependsOn": ["@kavita-likes-fajitas/shadcn-ui-lib#build"]
    },
    "@kavita-likes-fajitas/ui-library#test-ci": {
      "dependsOn": ["@kavita-likes-fajitas/shadcn-ui-lib#build"]
    },
    "dammit-i-need-a-new-job#typecheck": {
      "dependsOn": ["@kavita-likes-fajitas/kavita-fajita-icons#build"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env.development", ".env"],
      "cache": false,
      "persistent": true
    },
    "@kavita-likes-fajitas/storybook#build": {
      "dependsOn": ["^build"]
    },
    "@kavita-likes-fajitas/ui-library#dev": {
      "dependsOn": ["@kavita-likes-fajitas/shadcn-ui-lib#build"],
      "cache": false,
      "persistent": true
    }
  }
}
