{
  "name": "@kavita-likes-fajitas/ui-library",
  "version": "0.1.0",
  "license": "MIT",
  "description": "ui components made with tailwind-css/react/typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/kavitalikesfajitas/portfolio.git",
    "directory": "packages/ui-library"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./*.css": "./dist/*.css",
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test-ci": "vitest run --coverage --reporter=dot",
    "lint": "eslint",
    "generate:component": "turbo gen react-component"
  },
  "dependencies": {
    "@kavita-likes-fajitas/shadcn-ui-lib": "workspace:*",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4",
    "clsx": "^2.1.1",
    "motion": "^12.23.24",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@kavita-likes-fajitas/eslint-config": "workspace:*",
    "@kavita-likes-fajitas/tailwind-config": "workspace:*",
    "@kavita-likes-fajitas/typescript-config": "workspace:*",
    "@rollup/plugin-url": "^8.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tsdown/css": "^0.21.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.553.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4",
    "tsdown": "^0.21.9",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
