{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kavita-likes-fajitas/typescript-config/react-library",
    "compilerOptions": {
        "types": [
            "./src/types/cssModule.d.ts",
            "@testing-library/jest-dom",
            "vitest/globals"
        ]
    },
    "include": [
        ".eslint.config.mjs",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.mts",
        "src/**/*.mjs",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.json",
        "__tests__/**/test.ts",
        "__tests__/**/test.tsx"
    ],
    "exclude": [
        "node_modules/**",
        "**/.*/*",
        "./dist"
    ]
}