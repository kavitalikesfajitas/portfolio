{
  "name": "@kavita-likes-fajitas/shadcn-ui-lib",
  "version": "0.1.0",
  "license": "MIT",
  "description": "shadcn components only since they have a different file structure",
  "repository": {
    "type": "git",
    "url": "https://github.com/kavitalikesfajitas/portfolio.git",
    "directory": "packages/shadcn-ui-lib"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "styles/**/*.css"
  ],
  "exports": {
    "./styles/*": "./styles/*",
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test-ci": "vitest run --coverage --reporter=dot",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.553.0",
    "radix-ui": "^1.5.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@kavita-likes-fajitas/eslint-config": "workspace:*",
    "@kavita-likes-fajitas/tailwind-config": "workspace:*",
    "@kavita-likes-fajitas/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.4",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.10",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4",
    "tsdown": "^0.21.9",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
