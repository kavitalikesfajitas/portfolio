{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kavita-likes-fajitas/typescript-config/react-library",
    "compilerOptions": {
        // SVGR-generated components in src/components use runtime-style
        // `import { Ref, forwardRef }`, which the base config's
        // verbatimModuleSyntax forbids. The generated code is throwaway, so
        // relax the rule here rather than post-process every generated file.
        "verbatimModuleSyntax": false
    },
    "include": [
        ".eslint.config.mjs",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.mts",
        "src/**/*.mjs",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.json",
        "__tests__/**/test.ts",
        "__tests__/**/test.tsx"
    ],
    "exclude": [
        "node_modules/**",
        "**/.*/*",
        "./dist"
    ]
}