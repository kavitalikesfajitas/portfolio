{
  "extends": "./base.json",
  "display": "React App/Library",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [
      "node",
      "react",
      "react-dom",
      "@testing-library/jest-dom",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "outDir": "./dist"
  },
  "exclude": ["**/node_modules", "**/.*/", "**/dist"]
}
